    <!-- About screen -->
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Finds receipt and label printers on your Wi-Fi network by probing the ports they listen on (9100, 8100, 631, 515 …) and sends text or images to them over ESC/POS (RAW), LPD or IPP.</string>
    <string name="about_how_title">How to use</string>
    <string name="about_how">1. Connect the phone to the same Wi-Fi as the printer.\n2. Tap “Scan network” — every host with an open printer port is listed.\n3. Tap a port, type text and/or choose an image, then tap “Print”.\n\nIf Cyrillic prints as garbage, change the code page (CP866 / CP1251) or the ESC t number to match your printer.</string>
